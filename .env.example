# --- CHANGE THESE BEFORE DEPLOYING ---
ADMIN_USER=admin
ADMIN_PASS=changeme-pick-a-strong-password
SECRET_KEY=generate-with-openssl-rand-hex-32
MANAGER_PORT=8000
MOCK_DOCKER=false
# IPs/CIDRs allowed to open /admin + use the management API (login page included).
# Empty = no restriction (login still required). Localhost is always allowed.
# Behind Cloudflare Tunnel this reads CF-Connecting-IP. Example:
# ADMIN_ALLOWED_IPS=192.168.50.0/24, 203.0.113.7
ADMIN_ALLOWED_IPS=
# Optional: playit.gg Docker agent secret (only if using --profile playit).
# Host-binary mode (setup-server.sh --with-playit) doesn't need this.
PLAYIT_SECRET=
